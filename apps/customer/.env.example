# Disabled by default. This template uses loopback HTTP; Render needs separate setup.
PORTAL_MODE=closed
PORTAL_ORIGIN=http://127.0.0.1:3100
SUPABASE_URL=http://127.0.0.1:54321
# Supply a publishable key from a separately authorized LOCAL 4IR stack.
SUPABASE_PUBLISHABLE_KEY=

# Render preparation stays closed. See docs/PHASE-2-RENDER-PILOT.md before use.
# Never place pilot access material or user IDs in NEXT_PUBLIC_ variables.
PORTAL_PILOT_ENABLED=false
PORTAL_PILOT_ACCESS_SHA256=
PORTAL_PILOT_USER_IDS=
